# ---------------------------------------------------------------
# Magic Frames Studio — PRODUCTION environment template
# Copy to .env on the server, then fill in every value marked CHANGE.
# Never commit the real .env file.
# ---------------------------------------------------------------
APP_NAME="Magic Frames Studio"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # CHANGE: run  php artisan key:generate --force
APP_URL=https://magicframes.co.in   # CHANGE if different (must be the public https address)
APP_LOCALE=en
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database (MySQL 8 / MariaDB 10.6+) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=magicframes       # CHANGE
DB_USERNAME=magicframes       # CHANGE
DB_PASSWORD=                  # CHANGE (long random password)

# --- Sessions, cache, queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# --- Reverse proxy / Cloudflare: list proxy IPs, or * to trust any (only if the server is not directly reachable) ---
TRUSTED_PROXIES=

# --- First administrator (used once by: php artisan db:seed --force) ---
ADMIN_NAME="Administrator"
ADMIN_EMAIL=                  # CHANGE
ADMIN_PASSWORD=               # CHANGE (min 10 chars; change it again after first login, then remove it from this file)

# --- Email (enquiry alerts + password reset). Use your hosting provider's SMTP ---
MAIL_MAILER=smtp
MAIL_HOST=                    # CHANGE e.g. smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=                # CHANGE
MAIL_PASSWORD=                # CHANGE
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=            # CHANGE e.g. no-reply@magicframes.co.in
MAIL_FROM_NAME="${APP_NAME}"
ENQUIRY_NOTIFY_EMAIL=         # optional; otherwise the e-mail in Admin → Site settings is used

# --- Uploads (KB). php.ini upload_max_filesize / post_max_size must be at least as large ---
MEDIA_MAX_IMAGE_KB=20480
MEDIA_MAX_VIDEO_KB=512000
MEDIA_MAX_PROCESSING_MEMORY_MB=1024

# --- Automatic daily backup (needs the cron entry from docs/DEPLOYMENT.md) ---
BACKUP_ENABLED=true
BACKUP_TIME=02:30
BACKUP_KEEP=14
MYSQLDUMP_PATH=mysqldump
